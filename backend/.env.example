NODE_ENV=development
PORT=4000

# MongoDB connection
DB_URL=mongodb://127.0.0.1:27017/inventra

# JWT auth
JWT_ACCESS_SECRET=replace_with_a_strong_access_secret
# Optional comma-separated previous access-token signing secrets during rotation grace window.
JWT_ACCESS_SECRET_PREVIOUS=
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_SECRET=replace_with_a_strong_refresh_secret
# Optional comma-separated previous refresh-token signing secrets during rotation grace window.
JWT_REFRESH_SECRET_PREVIOUS=
JWT_REFRESH_EXPIRES=7d
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_TEST_BYPASS=false

# HTTP CORS allowlist (comma-separated). Required in production.
CORS_ORIGIN=http://localhost:3000

# Realtime socket mode
REALTIME_ENABLED=false
SOCKET_CORS_ORIGIN=http://localhost:3000
SOCKET_EVENT_RATE_LIMIT_ENABLED=true
SOCKET_EVENT_WINDOW_MS=10000
SOCKET_EVENT_MAX_EVENTS=60
SOCKET_EVENT_MAX_VIOLATIONS=3

# Optional horizontal scaling (Socket.IO Redis adapter)
REALTIME_REDIS_ENABLED=false
REALTIME_REDIS_URL=redis://127.0.0.1:6379
BACKGROUND_JOB_QUEUE_ENABLED=false
BACKGROUND_JOB_REDIS_URL=redis://127.0.0.1:6379
BACKGROUND_JOB_QUEUE_NAME=inventra:background-jobs
BACKGROUND_JOB_WORKER_CONCURRENCY=3
BACKGROUND_JOB_RUN_INLINE_WORKER=true
BACKGROUND_JOB_ARTIFACT_DIR=tmp/background-job-artifacts

# Optional distributed rate limiting
RATE_LIMIT_REDIS_ENABLED=false
RATE_LIMIT_REDIS_URL=redis://127.0.0.1:6379
RATE_LIMIT_REDIS_PREFIX=inventra:rate-limit:
SUBSCRIPTION_RATE_LIMIT_ENABLED=true
SUBSCRIPTION_RATE_LIMIT_WINDOW_MS=900000
SUBSCRIPTION_RATE_LIMIT_FALLBACK_LIMIT=300

# Cookie / proxy / CSRF hardening
TRUST_PROXY=
COOKIE_SECURE=
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
CSRF_ENABLED=true
CSRF_COOKIE_MAX_AGE_MS=86400000

# Request-body and HTTP timeout hardening
MAX_JSON_BODY_MB=1
MAX_FORM_BODY_MB=1
MAX_FORM_PARAM_COUNT=1000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=35000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000

# Observability
LOG_LEVEL=info
REQUEST_LOG_ENABLED=true
HTTP_LOGGER=morgan
SLOW_QUERY_THRESHOLD_MS=150
INVENTORY_INTEGRITY_CRON_ENABLED=true
INVENTORY_INTEGRITY_CRON=50 0 * * *
INVENTORY_INTEGRITY_AUTOFIX=false
INVENTORY_INTEGRITY_MAX_FINDINGS=200
INVENTORY_INTEGRITY_ALERT_THRESHOLD=1
INVENTORY_ADJUST_REQUIRE_WAREHOUSE_ID=true
INVENTORY_SENSITIVE_REASON_MIN_ROLE=manager
STOCKTAKE_VISION_PROVIDER=mock
STOCKTAKE_VISION_MAX_IMAGE_BYTES=5242880
STOCKTAKE_VISION_HTTP_URL=
STOCKTAKE_VISION_HTTP_TOKEN=
STOCKTAKE_VISION_HTTP_TIMEOUT_MS=12000
STOCKTAKE_VISION_POLICY_MIN_CONFIDENCE=0.72
STOCKTAKE_VISION_POLICY_MAX_VARIANCE_RATIO=0.45
STOCKTAKE_VISION_POLICY_MAX_ABSOLUTE_VARIANCE=30
STOCKTAKE_VISION_POLICY_REQUIRE_REVIEW=true
IDEMPOTENCY_KEY_TTL_DAYS=7
API_QUERY_CACHE_ENABLED=true
API_QUERY_CACHE_DEFAULT_TTL_MS=60000
DASHBOARD_CACHE_TTL_MS=60000
REPORT_CACHE_TTL_MS=120000
FORECAST_CACHE_TTL_MS=120000
FX_PROVIDER_URL_TEMPLATE=https://open.er-api.com/v6/latest/{base}
FX_HTTP_TIMEOUT_MS=8000
PUBLIC_API_BASE_URL=
HEALTHCHECK_DB_TIMEOUT_MS=1000
METRICS_ENABLED=false
METRICS_PREFIX=inventra_
METRICS_TOKEN=
ERROR_TRACKING_PROVIDER=webhook
ERROR_TRACKING_WEBHOOK_URL=
ERROR_TRACKING_SENTRY_DSN=
ERROR_TRACKING_SENTRY_TRACES_SAMPLE_RATE=0
ERROR_TRACKING_TIMEOUT_MS=2000
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_TIMEOUT_MS=2000
OPS_ALERT_COOLDOWN_MS=60000

# SMS low-stock alerts
SMS_PROVIDER=none
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_FROM=
SMS_LOW_STOCK_RECIPIENTS=
SMS_TIMEOUT_MS=4000

# WhatsApp low-stock alerts (Twilio-compatible)
WHATSAPP_PROVIDER=none
WHATSAPP_TWILIO_ACCOUNT_SID=
WHATSAPP_TWILIO_AUTH_TOKEN=
WHATSAPP_TWILIO_FROM=

# SMTP email notifications
EMAIL_NOTIFICATIONS_ENABLED=false
APP_WEB_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Inventra

# Migration defaults
MIGRATION_DRY_RUN=true
MIGRATION_DEFAULT_ORG_NAME=Legacy Organization
MIGRATION_DEFAULT_ORG_CODE=LEGACY

# Backup and restore simulation
BACKUP_OUTPUT_DIR=backups/snapshots
BACKUP_SNAPSHOT_TAG=
BACKUP_ORGANIZATION_ID=
SIMULATE_RESTORE_WRITE=false
SIMULATE_RESTORE_CLEANUP=true

