NODE_ENV=development
PORT=4000

# MongoDB connection
DB_URL=mongodb://127.0.0.1:27017/ledgerly

# JWT auth
JWT_ACCESS_SECRET=access_secret
JWT_ACCESS_EXPIRES=1d
JWT_REFRESH_SECRET=refresh_secret
JWT_REFRESH_EXPIRES=7d

# Realtime socket mode
REALTIME_ENABLED=false
SOCKET_CORS_ORIGIN=*

# Optional horizontal scaling (Socket.IO Redis adapter)
REALTIME_REDIS_ENABLED=false
REALTIME_REDIS_URL=redis://127.0.0.1:6379

# Migration defaults
MIGRATION_DRY_RUN=true
MIGRATION_DEFAULT_ORG_NAME=Legacy Organization
MIGRATION_DEFAULT_ORG_CODE=LEGACY
