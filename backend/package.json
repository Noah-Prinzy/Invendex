{
  "name": "ledgerly-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Ledgerly backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --passWithNoTests",
    "test:finance-realtime": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js src/tests/valuationService.test.js src/tests/financeLifecycle.test.js src/tests/realtimeSocket.test.js src/tests/financeRealtimeSmoke.test.js",
    "test:inventory-intelligence": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand src/tests/serialBatchTracking.test.js src/tests/dashboardIntelligence.test.js src/tests/serialHistoryApi.test.js src/tests/operationsPolish.test.js",
    "migrate:tenant": "node scripts/migrateTenantBackfill.js",
    "migrate:financial": "node scripts/migrateFinancialBackfill.js"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/src/tests_disabled/"
    ]
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.0",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "socket.io": "^4.8.3",
    "xlsx": "^0.18.5",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "socket.io-client": "^4.8.3",
    "supertest": "^6.3.4"
  }
}
