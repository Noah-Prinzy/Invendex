{
  "name": "invendex-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Invendex backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "worker:background-jobs": "node src/workers/backgroundJobWorker.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --passWithNoTests",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --passWithNoTests --coverage --runInBand",
    "test:finance-realtime": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js src/tests/valuationService.test.js src/tests/financeLifecycle.test.js src/tests/realtimeSocket.test.js src/tests/financeRealtimeSmoke.test.js",
    "test:auth-e2e": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand src/tests/authRegister.test.js src/tests/authE2e.test.js src/tests/userManagement.test.js",
    "test:inventory-intelligence": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand src/tests/serialBatchTracking.test.js src/tests/dashboardIntelligence.test.js src/tests/serialHistoryApi.test.js src/tests/operationsPolish.test.js",
    "migrate:tenant": "node scripts/migrateTenantBackfill.js",
    "migrate:financial": "node scripts/migrateFinancialBackfill.js",
    "migrate:warehouse-scope": "node scripts/reconcileWarehouseScope.js",
    "sync:product-stock": "node scripts/syncProductStockFromInventory.js",
    "backup:snapshot": "node scripts/createSnapshotBackup.js",
    "backup:simulate-restore": "node scripts/simulateSnapshotRestore.js"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/src/tests_disabled/"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 25,
        "functions": 35,
        "lines": 40,
        "statements": 40
      }
    }
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.70.1",
    "bwip-js": "^4.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.0",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.17.2",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.11.0",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.5.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^6.3.4"
  }
}
