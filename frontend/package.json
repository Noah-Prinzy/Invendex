{
  "name": "invendex-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Invendex frontend app",
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.3"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "check:bundle-budget": "node ./scripts/checkBundleBudgets.mjs",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx --max-warnings=0",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "vite build --mode analyze --sourcemap"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "rollup-plugin-visualizer": "^6.0.11",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "minimatch": "3.1.5"
  }
}
