# Workspace-level env guidance
#
# Backend:
#   copy backend/.env.example -> backend/.env
#   production guidance: backend/.env.production.example
#   development guidance: backend/.env.development.example
#
# Frontend:
#   optional frontend env file supports:
#   REACT_APP_API_BASE_URL=http://localhost:4000
#   REACT_APP_SOCKET_BASE_URL=http://localhost:4000
#   production guidance: frontend/.env.production.example
#   development guidance: frontend/.env.development.example

# Commerce / accounting integrations
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_API_ACCESS_TOKEN=
SHOPIFY_API_VERSION=

QUICKBOOKS_SANDBOX=true
QUICKBOOKS_COMPANY_ID=
