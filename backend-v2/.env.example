# Server
NODE_ENV=development
PORT=4000

# Persistence / queue
DB_URL=mongodb://127.0.0.1:27017/invendex
REDIS_URL=redis://127.0.0.1:6379
EVENTS_DRIVER=bullmq # bullmq | memory (memory is for tests)

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_ACCESS_PREVIOUS_SECRETS=
JWT_REFRESH_PREVIOUS_SECRETS=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REQUIRE_EMAIL_VERIFICATION=false
AUTH_TEST_BYPASS=false # only honored when NODE_ENV=test

# HTTP
CORS_ORIGIN=*
COOKIE_SECURE=false
API_DOCS_ENABLED=true

# Archival
AUDIT_LOG_TTL_DAYS=180

# i18n
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,sw,fr,lg

# URA EFRIS e-invoicing (Uganda)
EFRIS_API_BASE_URL=https://apisandbox.ura.go.ug/efrisapi/v1
EFRIS_API_KEY=

# Mobile money (MTN MoMo + Airtel Money via aggregator, or direct)
MOBILE_MONEY_PROVIDER=aggregator # aggregator | mtn | airtel
MOBILE_MONEY_AGGREGATOR_BASE_URL=https://api.flutterwave.com/v3
MOBILE_MONEY_API_KEY=

# Channels
SMS_PROVIDER=none # none | africastalking | termii
SMS_API_KEY=
WHATSAPP_PROVIDER=none # none | meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
USSD_PROVIDER=none # none | africastalking
USSD_SHORT_CODE=
